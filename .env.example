COMPOSE_PROJECT_NAME=geo-saas
GEO_IMAGE_PREFIX=geo-saas
# Production must set both values to the exact lowercase 40-character release commit.
GEO_IMAGE_TAG=local
GEO_IMAGE_REVISION=local

# Build-only sources verified for the current Linux server. The image digests match the pinned
# Dockerfile defaults; the frozen pnpm lockfile still verifies package integrity through the mirror.
NODE_IMAGE=public.ecr.aws/docker/library/node@sha256:1b044a60874f1b57ac8c4e708ddb3a00e55b34586ebbacce09a48796dafcc799
NGINX_IMAGE=public.ecr.aws/docker/library/nginx@sha256:d67ea0d64d518b1bb04acde3b00f722ac3e9764b3209a9b0a98924ba35e4b779
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright@sha256:cf0daee9b994042e011bc29f20cdff1a9f682a039b43fcd738f7d8a9d3bcd9d6
NPM_REGISTRY=https://registry.npmmirror.com
# Runtime edge image. Keep the reviewed multi-architecture digest; never replace it with a tag.
CADDY_IMAGE=public.ecr.aws/docker/library/caddy@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d

POSTGRES_DB=geo_saas
POSTGRES_ADMIN_USER=geo_admin
POSTGRES_ADMIN_PASSWORD=replace-admin-with-random-url-safe-value
GEO_API_DB_USER=geo_api
GEO_API_DB_PASSWORD=replace-api-with-random-url-safe-value
GEO_WORKER_DB_USER=geo_worker
GEO_WORKER_DB_PASSWORD=replace-worker-with-random-url-safe-value
GEO_IDENTITY_DB_USER=geo_identity_login
GEO_IDENTITY_DB_PASSWORD=replace-identity-with-random-url-safe-value

API_PORT=4100
# Host-facing API port; the container still listens on API_PORT internally.
API_HOST_PORT=10004
# Host-facing Web port; the container still listens on 8080 internally.
WEB_PORT=10003
# Optional operational-time offset for the static automation console. Use this
# only when the browser/host clock is known to differ from the business clock.
# The value is milliseconds and is translated back before task scheduling.
# Host-facing MCP port. Keep it above 10000; the container still listens on 9021 internally.
MCP_PORT=10001
# Host-facing Ctrip Bridge port. The bridge listens on 9030 in its isolated container namespace.
CTRIP_BRIDGE_HOST_PORT=10006
LOG_LEVEL=info
SESSION_SECRET=replace-session-secret-with-at-least-32-random-bytes
# The edge accepts exactly this lowercase ASCII FQDN. APP_ORIGIN must be its matching bare HTTPS
# origin with no path, query string, fragment, credentials or port.
GEO_PUBLIC_DOMAIN=geo.example.com
APP_ORIGIN=https://geo.example.com
# Optional SSH-only operator entrypoint. It must exactly match the loopback WEB_PORT and never uses
# a wildcard, non-loopback address or public listener.
GEO_OPERATOR_ORIGIN=http://127.0.0.1:10003
# Standard deployments always use the external governance endpoint below. The checked-in
# customer-demo Compose profile is the only place where demo_fixture is accepted.
GEO_DEPLOYMENT_PROFILE=standard
GEO_GOVERNANCE_MODE=external
# Set false while tenant memory is paused. Pi then uses only GEO tenant context, templates,
# Brand Agent Profiles, and verified facts; it does not expose or call plastic_context_supply.
# Publication audit_pre_check and defense remain active and fail closed.
GEO_CONTEXT_RETRIEVAL_ENABLED=false
# Plastic Promise stays on the Linux host loopback. The production-only GEO proxy binds only the
# dedicated governance bridge gateway and forwards to this host port; it is not publicly reachable.
PLASTIC_PROMISE_HOST_PORT=9020
PLASTIC_PROMISE_MCP_URL=http://172.30.11.2:10002/mcp
# Optional; uncomment only when the endpoint requires an Authorization header.
# PLASTIC_PROMISE_MCP_AUTHORIZATION=Bearer replace-from-secret-manager

# API-to-Agent production deadline. Keep this at least 10 seconds above AGENT_RUN_TIMEOUT_MS so
# the Agent service can return its own terminal result instead of being cut off by the API gateway.
AGENT_GATEWAY_RUN_TIMEOUT_MS=910000

# Fixture-only tenant UUID -> same-tenant active worker service-principal UUID map.
# Replace every entry with a separately provisioned least-privilege principal in production.
WORKER_TENANT_ACTORS_JSON={"10000000-0000-4000-8000-000000000001":"10000000-0000-4000-8000-000000000102","20000000-0000-4000-8000-000000000001":"20000000-0000-4000-8000-000000000102"}
# Linux production always starts one tenant-scoped Bridge. Both credential documents are required,
# must contain exactly one matching tenant, and must use the same independently generated token.
# Production Compose fixes the API-to-Bridge route to http://ctrip-bridge:9030 on an internal
# Docker network. Do not add a host-facing URL here.
CTRIP_BRIDGE_GATEWAY_CREDENTIALS_JSON=[{"tenantId":"11111111-1111-4111-8111-111111111111","accessToken":"replace-with-at-least-32-random-characters"}]
CTRIP_BRIDGE_TENANTS_JSON=[{"tenantId":"11111111-1111-4111-8111-111111111111","bridgePrincipalId":"replace-with-active-ctrip-bridge-principal-uuid","accessToken":"replace-with-the-same-at-least-32-random-characters"}]

# Map each active Ctrip account to its fixed adapter and active Bridge principal. The mapping contains
# no cookie/session secret; login state and every runtime publication gate remain independently checked.
# Legacy evidenceExpiresAt values are accepted for rolling upgrades but no longer gate account admission.
# [{"tenantId":"...","channelAccountId":"...","bridgePrincipalId":"...","adapterVersion":"ctrip-community-browser-unattended-v1","handoffTtlSeconds":900}]
CTRIP_ASSISTED_ACCOUNTS_JSON=[]

# This is the only active mode setting. browser_draft is a baseline browser/login/surface preflight;
# do not create the acceptance canary while it is selected because adapter identity is immutable.
# Change this value to browser_supervised before creating the real Phase A canary. The database Phase
# A gate still refuses permit issuance, consumption, and submission. Keep the same supervised adapter
# for the separately approved Phase B click and its public readback. browser_unattended is Phase C only.
CTRIP_BRIDGE_MODE=browser_draft
CTRIP_BROWSER_TRANSPORT=linux_service
CTRIP_BROWSER_TENANT_ID=11111111-1111-4111-8111-111111111111
CTRIP_REVIEW_CDP_ENDPOINT=http://browser-host:10005
GEO_RUNTIME_TMP_ROOT=/var/lib/geo/runtime/tmp
GEO_CTRIP_RUNTIME_ROOT=/srv/geo-saas/data/ctrip-runtime
GEO_BROWSER_PROFILE_ROOT=/srv/geo-saas/browser-profiles
GEO_BROWSER_DOWNLOAD_ROOT=/srv/geo-saas/browser-downloads
GEO_BROWSER_ARTIFACT_ROOT=/srv/geo-saas/browser-artifacts
# Generate this x11vnc password file interactively on the server; it is never an env secret.
CTRIP_VNC_PASSWORD_FILE=/srv/geo-saas/secrets/ctrip-vnc.passwd
CTRIP_NOVNC_HOST_PORT=10007
CTRIP_BROWSER_MAX_ACTIVE_SESSIONS=8
CTRIP_BROWSER_PROCESS_LIMIT=256
CTRIP_BROWSER_TASK_LIMIT=1536
# Operator browsers reach this only through the loopback SSH tunnel. This URL
# opens the real persisted Browser Host profile and is never routed by Caddy.
GEO_ACCOUNT_BROWSER_LOGIN_BASE_URL=http://127.0.0.1:10007/vnc.html?autoconnect=true&resize=scale
# Deprecated rolling-upgrade alias. Prefer GEO_ACCOUNT_BROWSER_LOGIN_BASE_URL.
GEO_CTRIP_BROWSER_LOGIN_BASE_URL=http://127.0.0.1:10007/vnc.html?autoconnect=true&resize=scale
WORKER_BATCH_SIZE=25
WORKER_CONCURRENCY=4
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=5
WORKER_POLL_INTERVAL_MS=1000

# Standard production requires a real server-side Pi provider, model, and key. Fixture Pi is limited
# to the separate customer_demo profile and is rejected by production preflight.
AGENT_PROVIDER=openai
AGENT_MODEL=replace-with-approved-production-model
AGENT_API_KEY=replace-with-provider-key
# Real Pi production runs may perform several governed tool calls and licensed-media inspections.
# The Web proxy allows 920 seconds only for POST /api/agent/runs.
AGENT_RUN_TIMEOUT_MS=900000
# One entry per Web-enabled tenant. accessToken must match that tenant's MCP principal below.
AGENT_GATEWAY_CREDENTIALS_JSON=[{"tenantId":"00000000-0000-4000-8000-000000000000","accessToken":"replace-with-at-least-32-random-characters"}]
# Real Pi mode supports either a provider/model from Pi's registry or the explicit custom mode:
# AGENT_PROVIDER=openai-compatible
# AGENT_MODEL=your-approved-model-id
# AGENT_API=openai-responses
# AGENT_BASE_URL=https://your-approved-endpoint.example/v1
# AGENT_API may be openai-responses or openai-completions and must match the reviewed provider
# wire protocol. There is no automatic fallback between them. Non-loopback HTTP, embedded
# credentials, query strings and fragments are rejected. This changes orchestration only;
# platform publishing and visibility adapters remain unchanged.
# For reviewed Chat Completions providers whose SSE stream is unstable but whose JSON response is
# compatible, set AGENT_COMPLETIONS_MODE=json. The default is stream, and json is rejected for
# providers that are not configured with AGENT_API=openai-completions.
# AGENT_COMPLETIONS_MODE=stream
# Match Codex's reasoning setting when using the same approved endpoint.
# AGENT_REASONING_EFFORT=high
# Official DeepSeek V4 Pro uses Chat Completions JSON mode. low is sent as the provider's
# reasoning_effort=low and thinking is explicitly enabled; reasoning_content is retained across
# tool-call continuations.
# AGENT_MODEL=deepseek-v4-pro
# AGENT_API=openai-completions
# AGENT_BASE_URL=https://api.deepseek.com
# AGENT_COMPLETIONS_MODE=json
# AGENT_REASONING_EFFORT=low
# Media inspection uses an independent vision-capable provider. Production must configure this
# block explicitly so changing the drafting model cannot silently change visual review behavior.
# MEDIA_INSPECTION_PROVIDER=openai-compatible
# MEDIA_INSPECTION_MODEL=replace-with-approved-vision-model
# MEDIA_INSPECTION_API=openai-responses
# MEDIA_INSPECTION_BASE_URL=https://approved-vision-endpoint.example/v1
# MEDIA_INSPECTION_COMPLETIONS_MODE=stream
# MEDIA_INSPECTION_API_KEY=replace-with-vision-provider-key
# Enable only after the reviewed upstream accepts strict function tools. This keeps Pi on native
# tool calling and asks the provider to return schema-constrained JSON arguments.
# AGENT_STRICT_TOOL_ARGUMENTS=false

# Explicit background automation switch. Production stays off through Phase A/B. Enabling it is a
# separate Phase C decision after the unique canary has a matching public readback.
AUTOMATION_PRODUCER_ENABLED=false
# Keep this stable across restarts so lease ownership is diagnosable. Run only one producer with
# the same ID; scale throughput with the bounded concurrency setting instead.
AUTOMATION_PRODUCER_ID=geo-automation-primary
AUTOMATION_PRODUCER_CONCURRENCY=1
AUTOMATION_PRODUCER_POLL_INTERVAL_MS=1000
AUTOMATION_PRODUCER_LEASE_DURATION_MS=60000
AUTOMATION_PRODUCER_HEARTBEAT_INTERVAL_MS=20000
# Bounds one Pi-authored draft attempt so a provider response body cannot hold the producer slot
# indefinitely while lease heartbeats remain healthy.
AUTOMATION_DRAFT_TIMEOUT_MS=600000
AUTOMATION_DELIVERY_POLL_INTERVAL_MS=1000
DOUBAO_ADAPTER=fixture
QWEN_ADAPTER=fixture

# Public trend collection is fail-closed and disabled until each tenant is mapped to an active
# automation service principal with automation:execute authority. The API fetches each fixed source
# once per cycle, then writes the resulting observations through the tenant-scoped TrendService.
TREND_COLLECTION_ENABLED=false
# TREND_COLLECTION_TENANT_ACTORS_JSON={"10000000-0000-4000-8000-000000000001":"10000000-0000-4000-8000-000000000101"}
TREND_COLLECTION_INTERVAL_MS=600000
TREND_COLLECTION_LIMIT_PER_SOURCE=20

# Trend-driven batch creation is a separate fail-closed lifecycle. Enabling it requires a
# tenant-keyed pipeline document whose actor is an active automation_producer principal with
# automation:execute authority. Each relevant topic creates one source run with account-bound
# targets for the configured platforms; idempotent replays do not emit a new operations snapshot.
TREND_AUTOMATION_ENABLED=false
# TREND_AUTOMATION_PIPELINES_JSON={"10000000-0000-4000-8000-000000000001":{"actorId":"10000000-0000-4000-8000-000000000101","campaignId":"10000000-0000-4000-8000-000000000201","platforms":["toutiao","sohu","baijiahao","netease"],"executionLevel":"dry_run","maxNewBatchesPerRun":20,"lookbackMinutes":1440,"minFreshnessScore":0.65,"relevanceTerms":["云南","旅游","旅行社"]}}
TREND_AUTOMATION_INTERVAL_MS=600000
AUTOMATION_PLAN_ENABLED=false
AUTOMATION_PLAN_INTERVAL_MS=60000
AUTOMATION_PLAN_MAX_PLANS_PER_RUN=100

# AI image generation is not connected. `fixture` only writes a deterministic, non-network PNG for
# pipeline verification and production rejects it. Licensed stock search is configured separately.
GEO_MEDIA_PROVIDER=disabled
GEO_MEDIA_SEARCH_PROVIDER=disabled
# `pexels` requires an official server-side key. Never expose it to the Web bundle or browser.
# PEXELS_API_KEY=replace-with-server-side-pexels-key
# Optional dedicated proxy used only for the fixed Wikimedia API/download hosts. Keep credentials
# in the server Secret and never configure a global HTTP(S) proxy for the application container.
# GEO_MEDIA_HTTPS_PROXY_URL=http://proxy-user:proxy-password@proxy.example.com:8080
GEO_MEDIA_OBJECT_ROOT=.data/media

MCP_ALLOWED_HOSTS=127.0.0.1:9021,localhost:9021,127.0.0.1:10001,localhost:10001
MCP_ALLOWED_ORIGINS=https://geo.example.com
# Seed users are disabled. Replace these credentials only after secure operator provisioning.
MCP_PRINCIPALS_JSON=[{"accessToken":"replace-with-at-least-32-random-characters","clientId":"geo-operator","email":"operator@example.com","password":"replace-after-provisioning","tenantSlug":"example-production-tenant"}]

# Production tenant provisioning profile. All values are explicit; [] is a valid contact list.
GEO_PROVISION_IDEMPOTENCY_KEY=ticket-approved-tenant-001
GEO_PROVISION_TENANT_SLUG=example-production-tenant
GEO_PROVISION_LEGAL_NAME="Example Production Tenant Co., Ltd."
GEO_PROVISION_DISPLAY_NAME="Example Production Tenant"
GEO_PROVISION_INDUSTRY=professional-services
GEO_PROVISION_DEFAULT_LOCALE=zh-CN
GEO_PROVISION_BRAND_CANONICAL_NAME="Example Production Brand"
GEO_PROVISION_BRAND_DISPLAY_NAME="Example Production Brand"
GEO_PROVISION_CONTACTS_JSON=[]
GEO_PROVISION_WORKER_NAME=example-production-publication-worker

# Operator bootstrap profile. Password has intentionally no default/example value.
GEO_BOOTSTRAP_TENANT_SLUG=example-production-tenant
GEO_BOOTSTRAP_EMAIL=operator@example.com
GEO_BOOTSTRAP_DISPLAY_NAME="Initial operator"
# Never store GEO_BOOTSTRAP_PASSWORD in this production env file; preflight rejects it.
# Inject it from a secret manager only for the one-shot operator bootstrap command.

# Optional provider settings. Uncomment only after official capability evidence is approved.
# DOUBAO_API_KEY=replace-after-provider-onboarding
# DOUBAO_BASE_URL=https://approved-provider-endpoint.example
# DOUBAO_MODEL=approved-model-id
# QWEN_API_KEY=replace-after-provider-onboarding
# QWEN_BASE_URL=https://approved-provider-endpoint.example
# QWEN_MODEL=approved-model-id

# Optional future infrastructure only. Current code does not consume Redis or MinIO.
# REDIS_URL=redis://127.0.0.1:6379/0
# MINIO_ENDPOINT=http://127.0.0.1:9000

# The applications do not load .env automatically. For direct pnpm commands, export URLs explicitly.
# DATABASE_URL=postgresql://geo_api:<url-safe-password>@127.0.0.1:5432/geo_saas
# DATABASE_IDENTITY_URL=postgresql://geo_identity_login:<url-safe-password>@127.0.0.1:5432/geo_saas
# DATABASE_ADMIN_URL is only for tenant/operator provisioning commands, never the API process.
