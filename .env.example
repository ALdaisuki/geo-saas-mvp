COMPOSE_PROJECT_NAME=geo-saas
GEO_IMAGE_PREFIX=geo-saas
GEO_IMAGE_TAG=local
BIND_ADDRESS=127.0.0.1

POSTGRES_DB=geo_saas
POSTGRES_ADMIN_USER=geo_admin
POSTGRES_ADMIN_PASSWORD=replace-admin-with-random-url-safe-value
GEO_API_DB_USER=geo_api
GEO_API_DB_PASSWORD=replace-api-with-random-url-safe-value
GEO_WORKER_DB_USER=geo_worker
GEO_WORKER_DB_PASSWORD=replace-worker-with-random-url-safe-value
GEO_IDENTITY_DB_USER=geo_identity_login
GEO_IDENTITY_DB_PASSWORD=replace-identity-with-random-url-safe-value

API_PORT=4100
WEB_PORT=4173
MCP_PORT=9021
LOG_LEVEL=info
SESSION_SECRET=replace-session-secret-with-at-least-32-random-bytes
# Production cookies are Secure. This must be the external TLS origin, not the direct HTTP port.
APP_ORIGIN=https://geo.example.com
# Required external governance dependency. Non-loopback endpoints must use HTTPS.
PLASTIC_PROMISE_MCP_URL=https://plastic-promise.example.com/mcp
# Optional; uncomment only when the endpoint requires an Authorization header.
# PLASTIC_PROMISE_MCP_AUTHORIZATION=Bearer replace-from-secret-manager

# Fixture-only actor; it exists only after the fixture-seed profile. Replace in production.
WORKER_ACTOR_ID=10000000-0000-4000-8000-000000000101
WORKER_BATCH_SIZE=25
WORKER_CONCURRENCY=4
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=5
WORKER_POLL_INTERVAL_MS=1000

AGENT_PROVIDER=fixture
AGENT_MODEL=fixture-geo-writer-v1
DOUBAO_ADAPTER=fixture
QWEN_ADAPTER=fixture

MCP_ALLOWED_HOSTS=127.0.0.1:9021,localhost:9021
MCP_ALLOWED_ORIGINS=https://geo.example.com
# Seed users are disabled. Replace these credentials only after secure operator provisioning.
MCP_PRINCIPALS_JSON=[{"accessToken":"replace-with-at-least-32-random-characters","clientId":"geo-operator","email":"operator@example.com","password":"replace-after-provisioning","tenantSlug":"zhongtong-international-travel"}]

# Operator bootstrap profile. Password has intentionally no default/example value.
GEO_BOOTSTRAP_TENANT_SLUG=zhongtong-international-travel
GEO_BOOTSTRAP_EMAIL=operator@example.com
GEO_BOOTSTRAP_DISPLAY_NAME="Initial operator"
# GEO_BOOTSTRAP_PASSWORD must be injected from a secret manager for the one-shot command.

# Optional provider settings. Uncomment only after official capability evidence is approved.
# DOUBAO_API_KEY=replace-after-provider-onboarding
# DOUBAO_BASE_URL=https://approved-provider-endpoint.example
# DOUBAO_MODEL=approved-model-id
# QWEN_API_KEY=replace-after-provider-onboarding
# QWEN_BASE_URL=https://approved-provider-endpoint.example
# QWEN_MODEL=approved-model-id

# Optional future infrastructure only. Current code does not consume Redis or MinIO.
# REDIS_URL=redis://127.0.0.1:6379/0
# MINIO_ENDPOINT=http://127.0.0.1:9000

# The applications do not load .env automatically. For direct pnpm commands, export URLs explicitly.
# DATABASE_URL=postgresql://geo_api:<url-safe-password>@127.0.0.1:5432/geo_saas
# DATABASE_IDENTITY_URL=postgresql://geo_identity_login:<url-safe-password>@127.0.0.1:5432/geo_saas
# DATABASE_ADMIN_URL is only for the operator bootstrap command, never the API process.
