{
  "name": "@geo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "typecheck:repository": "tsc -p tsconfig.repository.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/jwt": "10.0.0",
    "@geo/authz": "workspace:*",
    "@geo/agent": "workspace:*",
    "@geo/config": "workspace:*",
    "@geo/connectors": "workspace:*",
    "@geo/contracts": "workspace:*",
    "@geo/core": "workspace:*",
    "@geo/db": "workspace:*",
    "@geo/media": "workspace:*",
    "@geo/research": "workspace:*",
    "@geo/visibility": "workspace:*",
    "argon2": "0.44.0",
    "fastify": "5.6.2",
    "kysely": "0.28.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "4.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
