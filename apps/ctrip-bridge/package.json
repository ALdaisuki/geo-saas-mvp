{
  "name": "@geo/ctrip-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "review:surface": "tsx src/review-cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@geo/connectors": "workspace:*",
    "@geo/contracts": "workspace:*",
    "@geo/core": "workspace:*",
    "@geo/db": "workspace:*",
    "@geo/media": "workspace:*",
    "kysely": "0.28.8",
    "marked": "16.4.2",
    "playwright-core": "1.61.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
