[Unit]
Description=GEO SaaS consistent encrypted offsite backup cycle
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
OnFailure=geo-saas-alert@%n.service

[Service]
Type=oneshot
User=@@DEPLOY_USER@@
Group=@@DEPLOY_GROUP@@
EnvironmentFile=/srv/geo-saas/secrets/operations-backup.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/srv/geo-saas/app/current/scripts/run-production-backup-cycle.sh
UMask=0077
TimeoutStartSec=12h
# EXIT recovery has a 420s process cap. Keep enough stop grace for that recovery,
# timeout termination, filesystem cleanup, and systemd bookkeeping.
TimeoutStopSec=10min
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/srv/geo-saas
