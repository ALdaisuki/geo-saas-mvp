[Unit]
Description=GEO SaaS production health verification and bounded recovery
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
OnFailure=geo-saas-alert@%n.service

[Service]
Type=oneshot
User=@@DEPLOY_USER@@
Group=@@DEPLOY_GROUP@@
EnvironmentFile=/srv/geo-saas/secrets/operations-health.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/srv/geo-saas/app/current/scripts/check-production-health.sh
UMask=0077
# Covers the 420s manager process cap, the 150s HTTPS-verification cap, timeout
# termination grace, and setup/teardown margin.
TimeoutStartSec=12min
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/srv/geo-saas
