[Unit]
Description=GEO SaaS verified server-local recovery set
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=@@DEPLOY_USER@@
Group=@@DEPLOY_GROUP@@
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/srv/geo-saas/app/current/scripts/run-production-backup-cycle.sh --local-only
UMask=0077
TimeoutStartSec=45min
TimeoutStopSec=10min
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/srv/geo-saas
NoNewPrivileges=true
