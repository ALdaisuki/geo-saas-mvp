[Unit]
Description=GEO SaaS attested local runtime health verification and bounded recovery
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=@@DEPLOY_USER@@
Group=@@DEPLOY_GROUP@@
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/srv/geo-saas/app/current/scripts/check-production-health.sh --local-only
UMask=0077
TimeoutStartSec=9min
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/srv/geo-saas
NoNewPrivileges=true
