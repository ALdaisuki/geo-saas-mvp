{
  "name": "geo-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.0.0 <11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/darwin-x64",
      "@embedded-postgres/linux-arm64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/windows-x64",
      "argon2"
    ]
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "db:bootstrap:operator": "pnpm --filter @geo/db bootstrap:operator",
    "db:migrate": "pnpm --filter @geo/db migrate",
    "db:provision:tenant": "pnpm --filter @geo/db provision:tenant",
    "db:seed": "pnpm --filter @geo/db seed",
    "dev": "pnpm -r --parallel --if-present dev",
    "e2e": "pnpm --filter @geo/e2e test:e2e",
    "e2e:web": "pnpm --filter @geo/web-e2e test:e2e",
    "e2e:web:install": "pnpm --filter @geo/web-e2e exec playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "test:watch": "pnpm -r --parallel --if-present test:watch",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify:mvp": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm --filter @geo/db test:integration && pnpm e2e && pnpm e2e:web && pnpm build && git diff --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  }
}
