  },
  "dependencies": {
    "@geo/contracts": "workspace:*",
    "@mariozechner/pi-agent-core": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "typebox": "1.1.24",
    "zod": "4.4.3"
