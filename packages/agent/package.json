{
  "name": "@geo/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pi": {
      "types": "./dist/pi-runtime.d.ts",
      "default": "./dist/pi-runtime.js"
    },
    "./plastic-promise-transport": {
      "types": "./dist/plastic-promise-transport.d.ts",
      "default": "./dist/plastic-promise-transport.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
