{
  "name": "@geo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "bootstrap:operator": "tsx src/cli/bootstrap-operator.ts",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "test": "vitest run tests/bootstrap-contract.test.ts tests/migration-contract.test.ts tests/seed-contract.test.ts",
    "test:contracts": "vitest run tests/migration-contract.test.ts tests/seed-contract.test.ts",
    "test:integration": "vitest run tests/postgres.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@geo/authz": "workspace:*",
    "@geo/core": "workspace:*",
    "argon2": "0.44.0",
    "kysely": "0.28.8",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.6",
    "@types/node": "catalog:",
    "embedded-postgres": "18.1.0-beta.15",
    "tsx": "4.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
